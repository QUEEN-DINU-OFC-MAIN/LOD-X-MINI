{
  "name": "rcd-x-mini-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');try{const rs=p.resolve('..','server.js');if(fs.existsSync(rs))fs.copyFileSync(rs,p.resolve('server.js'));const r=p.resolve('..','node_modules'),s=p.resolve('node_modules');fs.mkdirSync(r,{recursive:true});for(const e of fs.readdirSync(s)){const d=p.join(r,e);if(!fs.existsSync(d))fs.symlinkSync(p.join(s,e),d,'dir')}}catch{}\"",
    "dev": "next dev -H 0.0.0.0",
    "build": "node -e \"const fs=require('fs'),p=require('path');try{const rs=p.resolve('..','server.js');if(fs.existsSync(rs))fs.copyFileSync(rs,p.resolve('server.js'))}catch{}\" && next build && node -e \"const fs=require('fs'),p=require('path');try{for(const k of['.next','public']){const d=p.resolve('..',k),s=p.resolve(k);if(!fs.existsSync(d)&&fs.existsSync(s))fs.symlinkSync(s,d,'dir')}}catch{}\"",
    "start": "next start"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.4",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
