{
  "name": "wa-mini-platform",
  "version": "1.0.0",
  "description": "Multi-session WhatsApp mini-bot platform: pairing website + session worker (Cloudflare R2, Heroku-ready, shardable)",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "site": "node site/index.js",
    "worker": "node --expose-gc --max-semi-space-size=2 --optimize-for-size --max-old-space-size=${HEAP_MB:-400} server/index.js",
    "start": "node server/index.js",
    "test": "node --test --test-force-exit test/",
    "all": "node --expose-gc --max-semi-space-size=2 --optimize-for-size --max-old-space-size=${HEAP_MB:-380} start-all.js",
    "vercel-build": "npm --prefix web run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "adm-zip": "^0.6.1",
    "async-mutex": "^0.5.0",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.3.0",
    "libsignal": "^6.0.0",
    "long": "^5.2.3",
    "lru-cache": "^11.1.0",
    "mongodb": "^7.7.0",
    "music-metadata": "^11.12.3",
    "mysql2": "^3.24.5",
    "p-queue": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "protobufjs": "^7.5.6",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "wa-sticker-formatter": "^4.4.4",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "s3rver": "^3.7.1"
  }
}